# Merge these settings into a local .env; keep your existing MySQL/JWT secrets.
# Use a dedicated demo database. Apply the existing migrations before starting.
NODE_ENV=development
PAYMENT_MODE=demo
PURCHASES_ENABLED=true
PORT=3000
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=kicket
DB_PASSWORD=changeme
DB_NAME=kicket_demo
JWT_SECRET=replace-with-at-least-32-random-characters
# Mailpit: optional local inbox for password recovery; no email credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@kicket.test
