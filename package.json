{
  "name": "tpdsw-backend",
  "module": "es2022",
  "version": "1.0.0",
  "description": "Este repositorio tiene la finalidad de almacenar la parte correspondiente al back-end de nuestro proyecto",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "ts-node src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "audit": "ts-node src/scripts/audit.ts",
    "migrate": "mikro-orm migration:up",
    "test": "tsc && vitest run",
    "test:integration": "tsc && vitest run --config vitest.integration.config.ts",
    "lint": "tsc --noEmit",
    "create-admin": "ts-node src/scripts/create-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/core": "6.5.9",
    "@mikro-orm/mysql": "6.5.9",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.8.0",
    "mysql2": "^3.14.1",
    "reflect-metadata": "0.2.2",
    "zod": "^4.0.13",
    "@mikro-orm/migrations": "6.5.9",
    "nodemailer": "^7.0.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.5.9",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "@types/nodemailer": "^6.4.17",
    "prettier": "3.5.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "packageManager": "pnpm@10.11.0"
}
